          "audioKey": "gb-b06-t03",
          "pron": "du yu HAV e TOI-let"
        },
        {
          "quem": "ele",
          "es": "Yes, just past the shops, on the right.",
          "en": "有的，过了那些商店就到，在右手边。",
          "audioKey": "gb-b06-r02"
        }
      ],
      "origem": "B06",
      "molde": "HAVE"
    },
